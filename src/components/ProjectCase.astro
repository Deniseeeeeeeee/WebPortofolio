---
import type { ProjectRow as Project } from '../lib/content/types';
import { formatRange } from '../lib/dates';
import ImageSlot from './ImageSlot.astro';

interface Props {
  project: Project;
  index: number;
}
const { project: p, index } = Astro.props;
const reverse = index % 2 === 1; // image-left, image-right, image-left …
const [main, a, b] = p.images;
const dates = formatRange(p.start, p.end, 'present') + (p.location ? ` · ${p.location}` : '');
const group = `case-${p.id}`;
const headingId = `case-${p.key.toLowerCase()}`;
---

<article
  class="case-row grid items-start gap-8 lg:grid-cols-2 lg:gap-12"
  data-side={reverse ? 'right' : 'left'}
  aria-labelledby={headingId}
>
  <div class:list={['case-gallery grid grid-cols-2 gap-3', reverse && 'lg:order-2']}>
    <div class="case-img col-span-2">
      <ImageSlot
        media={main.media}
        alt={main.alt}
        label={main.label}
        variant={p.mainStyle}
        group={group}
        parallax
      />
    </div>
    <div class="case-img">
      <ImageSlot
        media={a.media}
        alt={a.alt}
        label={a.label}
        group={group}
        showSize={false}
        widths={[320, 640, 800]}
        sizes="(min-width: 1024px) 280px, 50vw"
      />
    </div>
    <div class="case-img">
      <ImageSlot
        media={b.media}
        alt={b.alt}
        label={b.label}
        group={group}
        showSize={false}
        widths={[320, 640, 800]}
        sizes="(min-width: 1024px) 280px, 50vw"
      />
    </div>
  </div>

  <div class:list={['case-text', reverse && 'lg:order-1']}>
    <div class="case-fade flex flex-wrap items-center gap-2">
      <span class="label-mono rounded bg-blue-soft px-1.5 py-0.5 text-[12px] text-blue-dark">{p.key}</span>
      {p.inProgress && <span class="rounded bg-loz-progress-bg px-1.5 py-0.5 text-[11px] font-bold tracking-wide text-loz-progress-text uppercase">In progress</span>}
      <span class="text-[13px] text-muted">{dates}</span>
    </div>

    <h3 id={headingId} class="case-fade mt-4 font-display text-[28px] leading-tight font-semibold tracking-tight md:text-[32px]">
      {p.title}
    </h3>
    <p class="case-fade mt-3 text-muted">{p.description}</p>

    <dl class="case-fade mt-5 border-y border-line py-3">
      {
        p.facts.map((f) => (
          <div class="flex items-baseline justify-between gap-4 py-1.5 text-[14px]">
            <dt class="text-muted">{f.label}</dt>
            <dd class="text-right font-semibold text-ink">{f.value}</dd>
          </div>
        ))
      }
    </dl>

    <ul class="case-fade mt-5 list-disc space-y-2 pl-5 text-[15px] marker:text-ink">
      {p.bullets.map((b) => <li>{b}</li>)}
    </ul>

    <ul class="case-fade mt-5 flex flex-wrap gap-2" aria-label="Tools and deliverables">
      {
        p.tags.map((t) => (
          <li class:list={['chip !min-h-7 !px-3 !text-[12px] !font-semibold', t.strong ? 'bg-ink text-white' : 'border border-line bg-white text-ink']}>
            {t.label}
          </li>
        ))
      }
    </ul>
  </div>
</article>
