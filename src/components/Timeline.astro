---
import JiraTimeline from './JiraTimeline.vue';
import SectionLabel from './SectionLabel.astro';
import type { TimelineRow } from '../lib/content/types';
import { buildTimeline, timelineRange } from '../lib/content/timeline';

interface Props {
  rows: TimelineRow[];
  owner: string;
}
const { rows, owner } = Astro.props;
const buildTime = new Date().toISOString();
const items = buildTimeline(rows);
const range = timelineRange(rows);
const y1 = range.start.slice(0, 4);
const y2 = range.end.slice(0, 4);
---

<section id="timeline" class="bg-timeline section-pad" aria-labelledby="timeline-title">
  <div class="container-content">
    <SectionLabel text="01 / ROADMAP" />
    <h2 id="timeline-title" class="h2-section reveal-h2 mt-3">My {y1 === y2 ? y1 : `${y1}–${y2}`} timeline</h2>
    <p class="text-lead mt-4 max-w-[34rem] text-muted">
      Projects and leadership roles, laid out the way I plan work every day: as a Jira roadmap.
    </p>

    <div class="mt-10 md:mt-12">
      <JiraTimeline client:visible={{ rootMargin: '300px' }} buildTime={buildTime} items={items} range={range} owner={owner} />
    </div>
  </div>
</section>
