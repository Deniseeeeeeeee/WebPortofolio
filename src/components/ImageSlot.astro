---
import type { MediaRef } from '../lib/content/types';
import { mediaUrl, srcset } from '../lib/media';

interface Props {
  media: MediaRef | null | undefined;
  alt: string;
  label: string;
  size?: string;
  variant?: 'light' | 'dark' | 'blue';
  /** CSS aspect-ratio, e.g. '16 / 10' */
  aspect?: string;
  icon?: 'image' | 'user';
  /** Lightbox group id; when set and a real image exists, clicking opens the lightbox */
  group?: string;
  /** Show the size hint (small slots hide it) */
  showSize?: boolean;
  loading?: 'eager' | 'lazy';
  widths?: number[];
  sizes?: string;
  parallax?: boolean;
  class?: string;
}

const {
  media,
  alt,
  label,
  size = '1600 × 1000 px',
  variant = 'light',
  aspect = '16 / 10',
  icon = 'image',
  group,
  showSize = true,
  loading = 'lazy',
  widths = [480, 800, 1200, 1600],
  sizes = '(min-width: 1024px) 560px, 100vw',
  parallax = false,
  class: className,
} = Astro.props;

const variantClass = {
  light: 'bg-placeholder-light border-blue/40 text-blue-dark',
  dark: 'bg-placeholder-dark border-blue-light/30 text-blue-light',
  blue: 'bg-placeholder-blue border-white/40 text-white',
}[variant];
const subClass = { light: 'text-muted', dark: 'text-white/60', blue: 'text-white/75' }[variant];
const Tag = media && group ? 'button' : 'div';
---

{
  media ? (
    <Tag
      type={group ? 'button' : undefined}
      class:list={['img-slot group relative block w-full overflow-hidden rounded-card bg-mist', className]}
      style={`aspect-ratio: ${aspect}`}
      data-lightbox={group}
      data-full={group ? mediaUrl(media, media.width > 1600 ? 1600 : undefined) : undefined}
      data-alt={group ? alt : undefined}
      aria-label={group ? `Open image: ${alt}` : undefined}
    >
      <img
        src={mediaUrl(media, media.width > 800 ? 800 : undefined)}
        srcset={srcset(media, widths)}
        sizes={sizes}
        alt={alt}
        width={media.width}
        height={media.height}
        loading={loading}
        decoding="async"
        fetchpriority={loading === 'eager' ? 'high' : undefined}
        class:list={['img-slot-img h-full w-full object-cover', parallax && 'parallax-img']}
        data-parallax={parallax ? '' : undefined}
      />
    </Tag>
  ) : (
    <div
      class:list={[
        'img-slot flex flex-col items-center justify-center gap-1.5 rounded-card border border-dashed p-4 text-center',
        variantClass,
        className,
      ]}
      style={`aspect-ratio: ${aspect}`}
      role="img"
      aria-label={`Placeholder: ${label}`}
    >
      {icon === 'user' ? (
        <svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="8" r="4" />
          <path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6" />
        </svg>
      ) : showSize ? (
        <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="16" rx="2.5" />
          <circle cx="9" cy="10" r="1.8" />
          <path d="m21 16-5-5-9 9" />
        </svg>
      ) : null}
      <span class="text-[13px] font-semibold leading-snug">{label}</span>
      {showSize && <span class:list={['text-[11px]', subClass]}>{size}</span>}
    </div>
  )
}
