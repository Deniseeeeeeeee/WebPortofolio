# Copy to .env and fill in. Never commit .env.

# Admin login (local dev falls back to admin / admin123 when these are empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-password
# Any long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# Database. Leave empty locally to use data/local.db.
# Production (Vercel): create a free Turso database and paste its URL + token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
